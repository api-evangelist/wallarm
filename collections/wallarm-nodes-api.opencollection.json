{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wallarm Applications Nodes API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-WallarmApi-Token",
      "value": "{{X-WallarmApi-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Filter Nodes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us1.api.wallarm.com/v1/objects/node",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve all Wallarm filter nodes registered to the client account."
        },
        {
          "info": {
            "name": "Create Filter Node",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us1.api.wallarm.com/v2/node",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a new Wallarm filter node with the platform."
        }
      ]
    }
  ],
  "bundled": true
}