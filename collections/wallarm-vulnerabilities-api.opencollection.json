{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wallarm Applications Vulnerabilities API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-WallarmApi-Token",
      "value": "{{X-WallarmApi-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Vulnerabilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Vulnerabilities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us1.api.wallarm.com/v1/objects/vuln",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve detected vulnerabilities. Supports filtering by status, time range, and client ID."
        }
      ]
    }
  ],
  "bundled": true
}